{
  "name": "@openagentio/client",
  "version": "0.3.0",
  "description": "Framework-agnostic TypeScript client for the OpenAgentIO HTTP/SSE adapter.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "devDependencies": {
    "jsonschema": "^1.5.0",
    "typescript": "^5.8.0"
  }
}
